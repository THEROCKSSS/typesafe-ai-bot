# Environment file for TypeSafe AI Bot — copy to .env and fill in.
# NEVER commit the real .env (it is gitignored).

# --- required ---
DISCORD_TOKEN=
DISCORD_GUILD_ID=
OWNER_IDS=

# --- behavior ---
DRY_RUN=1
DB_PATH=data/tsabot.db
RULES_PATH=policy/rules.json

# --- channels / roles (optional; can also set via /config) ---
REPORTS_CHANNEL_ID=
MOD_LOG_CHANNEL_ID=
VOTE_ROLE_ID=

# --- spam ---
SPAM_TIMEOUT_MINUTES=10

# --- votes ---
VOTE_MIN=5
VOTE_PCT=0.6
VOTE_MINUTES=60

# --- notifications ---
# log (default): routine cases post to the mod log channel; DM alerts are
# opt-in ("dm"/"both"). Critical alerts reach owners in every mode.
# Can also be set per-server with /notify.
NOTIFY_MODE=log

# --- reports ---
REPORT_DAILY_CAP=5
REPORT_MIN_LEN=12
REPORT_INVALID_LIMIT=3

# --- automod confidence bands ---
AUTOMOD_HIGH=0.85
AUTOMOD_MEDIUM=0.60
REPORT_VALID_HIGH=0.75
REPORT_VALID_MEDIUM=0.45

# --- judge ---
JEV_MODEL=jev-latest
TYPESAFE_API_KEY=
OPENCODE_ZEN_API_KEY=
JUDGE_MAX_PER_MIN=60

# --- dashboard ---
DASHBOARD_PORT=8788
